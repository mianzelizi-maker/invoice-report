# AIレポート（任意）。すべて Vercel の「Environment Variables」に設定します。
# ここには値を書かないでください。このファイルはキー名の見本です。実際の値をGitHubに載せてはいけません。

# Claude API のキー（サーバー側の関数だけが読みます。ブラウザには渡りません）
ANTHROPIC_API_KEY=

# 1日の利用回数を数えるための Upstash Redis（REST）。キーと両方そろったときだけAIが有効になります
# （Vercel の Marketplace から Upstash Redis を追加すると KV_REST_API_URL / KV_REST_API_TOKEN が自動で入ります。その名前でも動きます）
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 上限（省略時：1人あたり3回／サービス全体30回、日本時間の1日ごと）
AI_DAILY_LIMIT_PER_IP=3
AI_DAILY_LIMIT_TOTAL=30

# 使うモデル（省略時 claude-opus-5-5）。費用を抑えたいときは claude-haiku-4-5 など
AI_MODEL=

# 緊急停止スイッチ。false にするとキーが入っていてもAIを使いません
AI_ENABLED=
