{
  "name": "invoice-report",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "sample": "node scripts/generate-sample.ts",
    "build:pages": "tsc -b && vite build --base=/invoice-report/ && node scripts/prepare-pages.mjs",
    "deploy:pages": "npm run build:pages && gh-pages -d dist -t -m \"Deploy to GitHub Pages\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@react-pdf/renderer": "^4.9.0",
    "papaparse": "^5.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "gh-pages": "^6.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
